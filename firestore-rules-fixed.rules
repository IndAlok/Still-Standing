rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document and others can read
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == userId || request.auth.uid == resource.data.firebaseUID);
    }
    
    // Crew rules - authenticated users can create, members can read/write
    match /crews/{crewId} {
      // Allow creation if user is the creator
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.createdBy;
      
      // Allow reading public crews or crews user is member of
      allow read: if request.auth != null && 
        (resource.data.isPublic == true || 
         request.auth.uid in resource.data.members);
      
      // Allow updates if user is creator or member
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.createdBy || 
         request.auth.uid in resource.data.members);
      
      // Allow deletion only by creator
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
    }
    
    // Membership rules - users can manage their own memberships
    match /memberships/{membershipId} {
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Message rules - members can create messages in their crews
    match /messages/{messageId} {
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.senderId;
      
      // Allow reading messages if user is member of the crew
      allow read: if request.auth != null;
      
      // Allow updating/deleting own messages
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.senderId;
    }
    
    // Allow reading public crews for discovery
    match /crews/{crewId} {
      allow read: if resource.data.isPublic == true;
    }
  }
}
