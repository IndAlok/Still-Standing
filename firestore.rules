rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.firebaseUID ||
        request.auth.uid == userId
      );
      // Allow users to read other user profiles (for displaying in chats)
      allow read: if request.auth != null;
    }
    
    // Crews/Groups rules
    match /crews/{crewId} {
      // Anyone authenticated can read public crews
      allow read: if request.auth != null;
      // Only authenticated users can create crews
      allow create: if request.auth != null;
      // Only crew creator can update/delete
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
    }
    
    // Memberships rules
    match /memberships/{membershipId} {
      // Users can read memberships they're part of or for crews they're in
      allow read: if request.auth != null;
      // Users can create memberships (join crews)
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      // Users can update their own membership
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      // Users can delete their own membership (leave crew)
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }
    
    // Messages rules
    match /messages/{messageId} {
      // Anyone authenticated can read messages
      allow read: if request.auth != null;
      // Only authenticated users can create messages
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.senderId;
      // Only message sender can update their message
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.senderId;
      // Only message sender can delete their message
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.senderId;
    }
    
    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
